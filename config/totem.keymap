#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Increase scroll speed (default is usually 10)
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 35
#include <dt-bindings/zmk/mouse.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define FUN  4
#define WIN  5
#define FUN2 6

#define KEYS_L  0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25
#define KEYS_R  5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31
#define THUMB_L 32 33 34
#define THUMB_R 35 36 37
// Left thumb cluster minus SPACE (34) — excluded from hold triggers so
// finishing a right-hand word with a space doesn't risk firing a hold
#define THUMB_L_MOD 32 33

/ {
    /* combos { */
    /*     compatible = "zmk,combos"; */
    /*     combo_caps { */
    /*         timeout-ms = <50>; */
    /*         key-positions = <12 13>; */
    /*         bindings = <&kp F19>; */
    /*         layers = <BASE>; */
    /*     }; */
    /*     combo_dqt { */
    /*         timeout-ms = <50>; */
    /*         key-positions = <16 17>; */
    /*         bindings = <&kp CAPS>; */
    /*         layers = <BASE>; */
    /*     }; */
    /* }; */

    macros {
        tap_f18: tap_f18 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <30>;
            bindings = <&kp F18>;
        };
    };

    behaviors {
        // Home row mods (Ctrl, Alt, GUI) — slower, safer
        hml: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <225>;
            hold-trigger-key-positions = <KEYS_R THUMB_R>;
            hold-trigger-on-release;
        };
        hmr: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <225>;
            hold-trigger-key-positions = <KEYS_L THUMB_L_MOD>;
            hold-trigger-on-release;
        };
        // Home row shift (F/J) — faster, snappier
        hmls: hrm_left_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <225>;
            hold-trigger-key-positions = <KEYS_R THUMB_R>;
            hold-trigger-on-release;
        };
        hmrs: hrm_right_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <225>;
            hold-trigger-key-positions = <KEYS_L THUMB_L_MOD>;
            hold-trigger-on-release;
        };
        // Positional thumb modifiers — left thumb modifies right-hand keypresses
        lt_thumb_l: lt_thumb_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMB_R>;
            hold-trigger-on-release;
        };
        // Positional thumb modifiers — right thumb modifies left-hand keypresses
        lt_thumb_r: lt_thumb_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMB_L>;
            hold-trigger-on-release;
        };
        mt_thumb_r: mt_thumb_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMB_L>;
            hold-trigger-on-release;
        };
        sk_thumb: sk_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&sk>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
        };
        mt_thumb_macro: mt_thumb_macro {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&tap_f18>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMB_L>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
//                            ┌─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┐   ┌─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┐
                              &kp Q                     &kp W                     &kp E                     &kp R                     &kp T                         &kp Y                     &kp U                     &kp I                     &kp O                     &kp P
//                            ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤   ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤
                              &hml LCTRL A              &hml LALT S               &hml LGUI D               &hmls LSHFT F             &kp G                         &kp H                     &hmrs RSHFT J             &hmr RGUI K               &hmr RALT L               &hmr RCTRL SEMI
//  ┌─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┐   ┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤
    &kp LSHFT               &kp Z                     &kp X                     &kp C                     &kp V                     &kp B                         &kp N                     &kp M                     &kp COMMA                 &kp DOT                   &kp FSLH                  &kp RSHFT
//  └─────────────────────────┴─────────────────────────┴─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤   ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┴─────────────────────────┴─────────────────────────┘
                                                                                  &lt_thumb_l FUN ESC       &lt_thumb_l NAV TAB       &kp SPACE                     &lt_thumb_r SYM RET       &lt_thumb_r NUM BSPC     &mt_thumb_macro RS(RC(RA(RGUI))) 0
//                                                                                └─────────────────────────┴─────────────────────────┴─────────────────────────┘   └─────────────────────────┴─────────────────────────┴─────────────────────────┘
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
//                            ┌─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┐   ┌─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┐
                              &kp C_PREVIOUS            &kp C_PP                  &kp C_NEXT                &kp LG(GRAVE)             &kp LG(TAB)                   &kp K_UNDO                &kp K_CUT                 &kp K_COPY                &kp K_PASTE               &kp K_REDO
//                            ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤   ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤
                              &kp LCTRL                 &kp LALT                  &kp LGUI                  &kp LSHFT                 &kp LC(UP)                    &kp LEFT                  &kp DOWN                  &kp UP                    &kp RIGHT                 &kp CAPS
//  ┌─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┐   ┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤
    &kp C_MUTE                &kp C_VOL_DN              &kp C_VOL_UP              &kp LC(LEFT)              &kp LC(DOWN)              &kp LC(RIGHT)                 &kp HOME                  &kp PG_DN                 &kp PG_UP                 &kp END                   &kp INS                   &trans
//  └─────────────────────────┴─────────────────────────┴─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤   ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┴─────────────────────────┴─────────────────────────┘
                                                                                  &trans                    &trans                    &trans                        &kp RET                   &kp BSPC                  &kp RS(RC(RA(RGUI)))
//                                                                                └─────────────────────────┴─────────────────────────┴─────────────────────────┘   └─────────────────────────┴─────────────────────────┴─────────────────────────┘
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
//                            ┌─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┐   ┌─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┐
                              &kp LBRC                  &kp AMPS                  &kp STAR                  &kp LPAR                  &kp RBRC                      &none                     &none                     &trans                    &trans                    &trans
//                            ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤   ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤
                              &kp COLON                 &kp DLLR                  &kp PRCNT                 &kp CARET                 &kp PLUS                      &none                     &kp RSHIFT                &kp RGUI                  &kp RALT                  &kp RCTRL
//  ┌─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┐   ┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤
    &kp TILDE                 &kp DQT                   &kp EXCL                  &kp AT                    &kp HASH                  &kp PIPE                      &trans                    &trans                    &trans                    &trans                    &trans                    &trans
//  └─────────────────────────┴─────────────────────────┴─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤   ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┴─────────────────────────┴─────────────────────────┘
                                                                                  &kp LPAR                  &kp RPAR                  &kp UNDER                     &trans                    &trans                    &trans
//                                                                                └─────────────────────────┴─────────────────────────┴─────────────────────────┘   └─────────────────────────┴─────────────────────────┴─────────────────────────┘
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
//                            ┌─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┐   ┌─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┐
                              &kp LBKT                  &kp N7                    &kp N8                    &kp N9                    &kp RBKT                      &trans                    &trans                    &trans                    &trans                    &trans
//                            ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤   ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤
                              &kp SEMI                  &kp N4                    &kp N5                    &kp N6                    &kp EQUAL                     &trans                    &kp RSHFT                 &kp RGUI                  &kp RALT                  &kp RCTRL
//  ┌─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┐   ┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤
    &kp GRAVE                 &kp SQT                   &kp N1                    &kp N2                    &kp N3                    &kp BSLH                      &trans                    &trans                    &trans                    &trans                    &trans                    &trans
//  └─────────────────────────┴─────────────────────────┴─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤   ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┴─────────────────────────┴─────────────────────────┘
                                                                                  &kp DOT                   &kp N0                    &kp MINUS                     &trans                    &trans                    &trans
//                                                                                └─────────────────────────┴─────────────────────────┴─────────────────────────┘   └─────────────────────────┴─────────────────────────┴─────────────────────────┘
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
//                            ┌─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┐   ┌─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┐
                              &kp F11                   &kp F12                   &kp F13                   &kp F14                   &kp F15                       &bt BT_SEL 0              &bt BT_SEL 1              &bt BT_SEL 2              &bt BT_SEL 3              &bt BT_CLR
//                            ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤   ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤
                              &kp F6                    &kp F7                    &kp F8                    &kp F9                    &kp F10                       &trans                    &kp RSHFT                 &kp RGUI                  &kp RALT                  &kp RCTRL
//  ┌─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┐   ┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤
    &kp CAPS                 &kp F1                    &kp F2                    &kp F3                    &kp F4                    &kp F5                        &kp F16                   &kp F17                   &kp F18                   &kp F19                   &kp F20                   &trans
//  └─────────────────────────┴─────────────────────────┴─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤   ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┴─────────────────────────┴─────────────────────────┘
                                                                                  &kp K_APP                 &trans                    &trans                        &out OUT_TOG              &mo FUN2                  &trans
//                                                                                └─────────────────────────┴─────────────────────────┴─────────────────────────┘   └─────────────────────────┴─────────────────────────┴─────────────────────────┘
            >;
        };

        win_layer {
            display-name = "Win";
            bindings = <
//                            ┌─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┐   ┌─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┐
                              &none                     &msc SCRL_UP              &none                     &none                     &none                         &none                     &none                     &none                     &none                     &none
//                            ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤   ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤
                              &msc SCRL_LEFT            &msc SCRL_DOWN            &msc SCRL_RIGHT           &none                     &none                         &kp LC(LG(LEFT))          &kp LC(LG(DOWN))          &kp LC(LG(UP))            &kp LC(LG(RIGHT))         &none
//  ┌─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┐   ┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤
    &tog WIN                  &none                     &none                     &none                     &none                     &none                         &none                     &none                     &none                     &none                     &none                     &trans
//  └─────────────────────────┴─────────────────────────┴─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤   ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┴─────────────────────────┴─────────────────────────┘
                                                                                  &none                     &none                     &none                         &trans                    &kp LC(LG(F))             &none
//                                                                                └─────────────────────────┴─────────────────────────┴─────────────────────────┘   └─────────────────────────┴─────────────────────────┴─────────────────────────┘
            >;
        };
        fun2_layer {
            display-name = "Fun2";
            bindings = <
//                            ┌─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┐   ┌─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┬─────────────────────────┐
                              &kp F11                   &kp F12                   &kp F13                   &kp F14                   &kp F15                       &trans                    &trans                    &trans                    &trans                    &trans
//                            ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤   ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤
                              &kp F6                    &kp F7                    &kp F8                    &kp F9                    &kp F10                       &trans                    &kp RSHFT                 &kp RGUI                  &kp RALT                  &kp RCTRL
//  ┌─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┐   ┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤
    &trans                    &kp F1                    &kp F2                    &kp F3                    &kp F4                    &kp F5                        &kp F16                   &kp F17                   &kp F18                   &kp F19                   &kp F20                   &trans
//  └─────────────────────────┴─────────────────────────┴─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┤   ├─────────────────────────┼─────────────────────────┼─────────────────────────┼─────────────────────────┴─────────────────────────┴─────────────────────────┘
                                                                                  &trans                    &trans                    &trans                        &trans                    &trans                    &trans
//                                                                                └─────────────────────────┴─────────────────────────┴─────────────────────────┘   └─────────────────────────┴─────────────────────────┴─────────────────────────┘
            >;
        };
    };
};

// Override mouse scroll behavior to be discrete jumps
&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <0>;
    delay-ms = <0>;
};

&sk {
    quick-release;
};
